# Database Connection
# Used by Prisma ORM for database migrations and queries
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/surya_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/surya_dev"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_secret_key_here_for_development_only"

# Supabase Client Configuration (Optional for purely backend Prisma setup, needed if using Supabase client directly)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Application Encryption Key (Used for encrypting sensitive fields)
ENCRYPTION_KEY="12345678901234567890123456789012"

# Vercel Configuration (CI/CD)
VERCEL_ORG_ID="your_vercel_org_id"
VERCEL_PROJECT_ID="your_vercel_project_id"
